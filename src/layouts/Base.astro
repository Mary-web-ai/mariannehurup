---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import logo from '../assets/brand/logo.svg';
import { site, type NavItem } from '../site';

interface Props {
  title: string;
  description?: string;
}
const { title, description = `${site.name}, ${site.tagline.toLowerCase()}. ${site.place}.` } = Astro.props;
const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? `${site.name} – ${site.tagline}` : `${title} | ${site.name}`;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.jpg', site.url).href;
const active = (i: { href?: string; match?: string }) => (i.match ? path.startsWith(i.match) : i.href ? path.startsWith(i.href) : false);

const ld = {
  '@context': 'https://schema.org',
  '@type': ['Physiotherapy', 'LocalBusiness'],
  name: site.name,
  description: `${site.tagline}. ${site.place}.`,
  url: site.url,
  telephone: `+${site.phoneHref.replace('+', '')}`,
  email: site.email,
  image: ogImage,
  areaServed: ['Pandrup', 'Aalborg'],
  address: { '@type': 'PostalAddress', addressLocality: 'Pandrup', addressCountry: 'DK' },
};
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffdf9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#indhold">Gå til indhold</a>
    <header class="nav">
      <div class="nav-in">
        <a class="brand" href="/" aria-label={`${site.name}, forside`}>
          <img src={logo.src} alt="" width="44" height="32" />
          <span>{site.name}</span>
        </a>
        <button class="menu-btn" type="button" aria-controls="menu" aria-expanded="false">
          <span class="burger" aria-hidden="true"></span><span>Menu</span>
        </button>
        <nav id="menu" class="menu" aria-label="Hovedmenu">
          <button class="menu-close" type="button" aria-label="Luk menu">&times;</button>
          <ul>
            {site.nav.map((i: NavItem) =>
              i.children ? (
                <li class="has-sub">
                  <span class="sub-label" aria-current={active(i) ? 'true' : undefined}>{i.label}</span>
                  <ul>
                    {i.children.map((c) => (
                      <li><a href={c.href} aria-current={path.startsWith(c.href) ? 'page' : undefined}>{c.label}</a></li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li><a href={i.href} aria-current={active(i) ? 'page' : undefined}>{i.label}</a></li>
              ),
            )}
          </ul>
          <a class="menu-call" href={`tel:${site.phoneHref}`}>Ring {site.phone}</a>
        </nav>
        <div class="scrim" hidden></div>
        <a class="nav-cta" href={`tel:${site.phoneHref}`}>
          <span class="nav-cta-label">Ring</span> <span class="nav-cta-num">{site.phone}</span>
        </a>
      </div>
    </header>
    <main id="indhold"><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-col">
          <p><strong>{site.name}</strong><br />{site.tagline}, {site.place}</p>
          {site.credentials && <p>{site.credentials}</p>}
          {site.cvr && <p><small>CVR {site.cvr}</small></p>}
        </div>
        <div class="foot-col">
          <p class="foot-h">Kontakt</p>
          <ul class="foot-links">
            <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <p class="foot-h">Find rundt</p>
          <ul class="foot-links">
            {site.nav.flatMap((i: NavItem) => (i.children ? i.children.map((c) => ({ ...c, label: `Kvinder 40+ ${c.label}` })) : [{ href: i.href!, label: i.label }])).map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </footer>
    <div class="callbar" role="region" aria-label="Kontakt hurtigt">
      <a class="btn" href={`tel:${site.phoneHref}`}>Ring {site.phone}</a>
      <a class="btn alt" href={`mailto:${site.email}`}>Skriv en mail</a>
    </div>
    <script is:inline>
      (function () {
        var btn = document.querySelector('.menu-btn');
        var menu = document.getElementById('menu');
        var scrim = document.querySelector('.scrim');
        if (!btn || !menu) return;
        var root = document.documentElement;
        var set = function (open) {
          root.classList.toggle('menu-open', open);
          btn.setAttribute('aria-expanded', String(open));
          scrim.hidden = !open;
          if (open) menu.querySelector('.menu-close').focus(); else if (root.dataset.wasOpen) btn.focus();
          root.dataset.wasOpen = open ? '1' : '';
        };
        btn.addEventListener('click', function () { set(true); });
        menu.querySelector('.menu-close').addEventListener('click', function () { set(false); });
        scrim.addEventListener('click', function () { set(false); });
        menu.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && root.classList.contains('menu-open')) set(false); });
        matchMedia('(min-width: 801px)').addEventListener('change', function (e) { if (e.matches) set(false); });
      })();
    </script>
  </body>
</html>
