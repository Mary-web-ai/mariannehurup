---
import { designs } from '../site';
---
<div class="design-toggle" role="group" aria-label="Vælg designforslag">
  <label for="design-select">Design</label>
  <select id="design-select">
    {designs.map((d) => <option value={d.id}>{d.label}</option>)}
  </select>
</div>
<script is:inline>
  (function () {
    var sel = document.getElementById('design-select');
    if (!sel) return;
    sel.value = document.documentElement.dataset.design || 'current';
    sel.addEventListener('change', function () {
      document.documentElement.dataset.design = sel.value;
      try { localStorage.setItem('design', sel.value); } catch (e) {}
      try { var u = new URL(location.href); u.searchParams.set('design', sel.value); history.replaceState(null, '', u); } catch (e) {}
    });
  })();
</script>
<style is:global>
  /* Ligger uden for designenes tokens, så den ser ens ud i alle forslag */
  .design-toggle {
    position: fixed; left: max(0.75rem, env(safe-area-inset-left)); bottom: max(0.75rem, env(safe-area-inset-bottom)); z-index: 60;
    display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.5rem 0.35rem 0.75rem;
    background: #1c1c1c; color: #fff; border-radius: 999px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    font: 600 0.8rem/1 system-ui, sans-serif;
  }
  .design-toggle label { color: #d8d8d8; }
  .design-toggle select {
    font: inherit; color: #fff; background: #333; border: 1px solid #666; border-radius: 999px; padding: 0.4rem 0.6rem; max-width: 11.5rem; min-height: 32px;
  }
  .design-toggle select:focus-visible { outline: 3px solid #f2c14e; outline-offset: 2px; }
  @media (max-width: 800px) { .design-toggle { bottom: calc(5rem + env(safe-area-inset-bottom)); } }
  @media print { .design-toggle { display: none; } }
</style>
