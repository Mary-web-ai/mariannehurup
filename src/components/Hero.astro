---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { kicker?: string; heading: string; sub?: string; image?: ImageMetadata; alt?: string; cta?: boolean; }
const { kicker, heading, sub, image, alt = '', cta = false } = Astro.props;
---
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-text">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{heading}</h1>
      {sub && <p class="lead">{sub}</p>}
      {cta && <p><a class="btn" href="/kontakt/">Kontakt mig</a></p>}
    </div>
    {image && (
      <Image class="hero-img" src={image} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 45vw" loading="eager" />
    )}
  </div>
</section>
