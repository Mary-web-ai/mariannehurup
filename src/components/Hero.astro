---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../site';
interface Props { kicker?: string; heading: string; sub?: string; image?: ImageMetadata; alt?: string; cta?: boolean; variant?: 'home'; }
const { kicker, heading, sub, image, alt = '', cta = false, variant } = Astro.props;
---
<section class:list={['hero', image && 'has-img', variant && `hero--${variant}`]}>
  <div class="wrap hero-in">
    <div class="hero-text">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{heading}</h1>
      {sub && <p class="lead">{sub}</p>}
      {cta && (
        <p class="hero-actions">
          <a class="btn" href="/kontakt/">Kontakt mig</a>
          <a class="btn alt" href={`tel:${site.phoneHref}`}>Ring {site.phone}</a>
        </p>
      )}
    </div>
    {image && (
      <Image class="hero-img" src={image} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 45vw" loading="eager" fetchpriority="high" />
    )}
  </div>
</section>
