---
import { site } from '../site';
---
<section class="band cta" aria-labelledby="cta-h">
  <div class="wrap">
    <p class="kicker">Vil du kontaktes angående</p>
    <h2 id="cta-h">Oplæg, foredrag, forløb eller workshop?</h2>
    <p class="cta-actions">
      <a class="btn" href={site.booking}>{site.bookingLabel}</a>
    </p>
    <p class="cta-note">Eller ring <a href={`tel:${site.phoneHref}`}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
</section>
